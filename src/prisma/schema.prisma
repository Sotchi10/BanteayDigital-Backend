generator client {
  provider   = "prisma-client-js"
  output     = "../generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum AnalysisStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ReportStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String     @id @default(cuid())
  phone_num    String?    @unique
  email        String?    @unique
  passwordHash String
  name         String?
  age          Int?
  avatarUrl    String?    @db.VarChar(512)
  role         UserRole   @default(USER)
  status       UserStatus @default(ACTIVE)
  tokenVersion Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  submissions     ScamSubmission[]
  reviewedReports ScamReport[]    @relation("ReportReviewer")
  communityPosts  CommunityPost[] @relation("PostAuthor")

  @@index([role])
  @@index([status])
}

model ScamSubmission {
  id              String         @id @default(cuid())
  userId          String
  title           String?        @db.VarChar(255)
  content         String         @db.LongText
  sourceUrl       String?        @db.VarChar(512)
  analysisStatus  AnalysisStatus @default(PENDING)
  riskLevel       RiskLevel?
  riskScore       Int?
  analysisSummary String?        @db.Text
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  report ScamReport?

  @@index([userId, createdAt])
  @@index([analysisStatus])
}

model ScamReport {
  id           String       @id @default(cuid())
  submissionId String       @unique
  status       ReportStatus @default(PENDING)
  reviewNote   String?      @db.Text
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  submission    ScamSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewedBy    User?          @relation("ReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  communityPost CommunityPost?

  @@index([status, createdAt])
  @@index([reviewedById])
}

model CommunityPost {
  id          String   @id @default(cuid())
  reportId    String   @unique
  authorId    String
  title       String   @db.VarChar(255)
  summary     String   @db.VarChar(500)
  content     String   @db.LongText
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  report ScamReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  author User       @relation("PostAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([publishedAt])
}
