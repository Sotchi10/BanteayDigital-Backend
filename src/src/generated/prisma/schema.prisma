generator client {
  // This backend is JavaScript, so use Prisma's JavaScript generator.
  provider   = "prisma-client-js"
  output     = "../src/generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "mysql"
}

model User {
  id        String    @id @default(cuid())
  phone_num String?   @unique
  email     String    @unique
  name      String?
  age       Int?
  comments  Comment[]
  likes     Like[]
  shares    Share[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

/// Posts are published by the BanteayDigital system not user.
model Post {
  id          String        @id @default(cuid())
  title       String
  content     String        @db.LongText
  status      PostStatus    @default(PUBLISHED)
  publishedBy PostPublisher @default(SYSTEM)
  publishedAt DateTime      @default(now())
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  comments Comment[]
  likes    Like[]
  shares   Share[]

  @@index([publishedAt])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

model Like {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model Share {
  id        String   @id @default(cuid())
  postId    String
  userId    String?
  channel   String?
  createdAt DateTime @default(now())

  post Post  @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([postId, createdAt])
}

enum PostPublisher {
  SYSTEM
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}
