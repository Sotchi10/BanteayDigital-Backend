# App
PORT=3000
CLIENT_ORIGINS=http://localhost:5173
NODE_ENV=development
RUN_DATABASE_TESTS=true

# Database
DATABASE_URL="mysql://user:password@localhost:3306/banteay_digital"

# Auth
JWT_SECRET=a_random_secret_key
JWT_EXPIRES_IN=_d

# Daily product quotas use this IANA timezone for their YYYY-MM-DD counters.
DAILY_QUOTA_TIME_ZONE=Asia/Bangkok
# Required in production. Used to HMAC guest IPs; never expose this value.
GUEST_QUOTA_HASH_SECRET=a_long_random_server_only_secret

# Request rate limits (per IP). Windows are in milliseconds.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
AI_RATE_LIMIT_WINDOW_MS=900000
AI_RATE_LIMIT_MAX=20
UPLOAD_RATE_LIMIT_WINDOW_MS=900000
UPLOAD_RATE_LIMIT_MAX=10
REPORT_RATE_LIMIT_WINDOW_MS=900000
REPORT_RATE_LIMIT_MAX=60

# Development only: set true to bypass request rate limits and daily quotas.
# This setting is ignored outside NODE_ENV=development.
DEV_BYPASS_RATE_LIMITS=false

# AI service
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=a_random_secret_key
# Scores below this value are omitted because they are not relevant enough.
AI_MATCH_MIN_SCORE=0.65
# Scores at or above this value are labelled LIKELY_RELATED.
AI_MATCH_CONFIDENCE_THRESHOLD=0.75

# Private Supabase Storage bucket for submitted scan images. Keep the secret
# key server-side only; never add it to frontend environment variables.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me
SUPABASE_STORAGE_BUCKET=scan-evidence

# Bypass
DEV_BYPASS_AUTH=true
DEV_BYPASS_USER_ID=user_id

# Scanner
VIRUSTOTAL_API_KEY=a_random_secret_key
